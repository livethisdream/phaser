# systemd unit for the Phaser headless backend -- TEMPLATE, not a live unit.
#
# This is the only definition of the unit. install.sh reads it, substitutes the
# at-sign placeholders below from its own SERVICE_USER / INSTALL_DIR /
# PYTHON_BIN constants, and installs the result on the Pi whenever the rendered
# text differs from /etc/systemd/system/phaser-headless.service -- so a Pi
# provisioned by an older version picks up template changes rather than keeping
# a stale unit. Rendering from install.sh's constants is the point: the unit's
# WorkingDirectory cannot drift away from the directory install.sh actually
# copies files into.
#
# Nothing else writes this file. The removed setup-pi.sh once carried its own
# heredoc copy of the unit, a second definition free to drift from this one.

[Unit]
Description=Phaser Headless Backend (browser-hosted beamforming + CW radar)
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1

# CTF mode secrets and tuning. The leading "-" makes the file optional, so a
# Pi that is not running the CTF starts exactly as before -- phaser_ctf.py then
# falls back to its demo sequence and placeholder flag.
#
#   PHASER_CTF_FLAG            the flag string handed back on a full match
#   PHASER_CTF_SEQUENCE        target sectors, e.g. "3 1 4 1 5"
#   PHASER_CTF_SOURCE          "tracked" (default) or "commanded"
#   PHASER_CTF_ALLOW_SIM       release the flag in sim mode at all
#   PHASER_CTF_TOLERANCE_DEG   half-width of a sector (default 5)
#   PHASER_CTF_DWELL_S         commanded: seconds held to confirm (default 2)
#   PHASER_CTF_TRACK_SWEEPS    tracked: sweeps held to confirm (default 3)
#   PHASER_CTF_SIGNAL_FLOOR_DB tracked: below this the peak is noise (-30)
#
# PHASER_CTF_SOURCE is the one to check first when the sequencer "does not
# work". The two sources score different things and only one runs at a time:
# "tracked" scores the measured peak angle, so the array holds still and the
# player carries the HB100 from sector to sector -- steering the beam does
# nothing, because the measured peak follows the source, not the steering.
# "commanded" scores the operator's steered ramp instead, which is what a
# table with a fixed, taped-down source needs. A kit set to "tracked" with an
# immovable source sits at whatever sector the source occupies and never
# advances, which looks identical to a hang.
#
# The file is NOT in this repo and install.sh cannot ship it: it is written
# once on the Pi, root-owned and 0600, because a service Environment= line is
# world-readable via `systemctl show`. Sidecar ctf_flag.txt / ctf_sequence.txt
# in @INSTALL_DIR@ remain the no-sudo alternative; the environment wins when
# both are present. See phaser_ctf.py.
EnvironmentFile=-/etc/default/phaser-ctf

ExecStart=@PYTHON@ -u @INSTALL_DIR@/phaser_headless.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
