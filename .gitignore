# Python-generated files
__pycache__/
*.py[oc]
build/
wheels/
*.egg-info

# Virtual environments. The project is WSL-native now, so the venv is
# in-tree (.venv/). The two names below are the out-of-tree symlinks the
# OneDrive-hosted copy used; kept so that checkout stays clean there.
.venv/
.venv-linux
.venv-win

# Stray root lockfile: there is no root package.json. Anchored with a
# leading slash so frontend/ and frontend-radar/ lockfiles stay tracked
# (CI needs them for npm ci).
/package-lock.json

# IDE
.idea/

# Build artifacts. phaser-installer.tar.gz is build-installer.py output;
# it was tracked by mistake and is stale (see archive/ notes).
phaser-installer/
phaser-installer.tar.gz
release/

# Stale duplicate of the systemd unit. scripts/setup-pi.sh writes the real
# one inline via heredoc, and this copy had already drifted from it
# (missing PYTHONUNBUFFERED, hardcoded /usr/bin/python3, old Description).
phaser-headless.service

# Calibration data (device-specific)
*.pkl
calibration.json
hb100_cal.txt

# Logs
logs/

# NOTE: LTE*.ftr are NOT ignored. They are AD9361 filter configs that
# phaser_find_hb100_headless.py loads at runtime, and install.sh ships them.

# Simulation data
sim_data.json

# Electron/Tauri (not using these)
electron/
src-tauri/

# NOTE: scripts/ and tests/ used to be listed here as legacy. They are not
# legacy any more -- c7a2f29 moved the setup scripts and the test suite into
# them and tracked the contents. The stale ignore rules survived and silently
# swallowed every NEW file added to either directory (already-tracked files
# ignore .gitignore, so nothing looked wrong). Do not re-add them.

# Legacy files (kept locally, not in repo)
radar/
diagnose_hardware.py
phaser_app.py
phaser_cal.py
phaser_find_hb100.py
phaser_gui.py
phaser_ipc_worker.py
phaser_server.py
requirements.txt
frontend/phaser_desktop.html
frontend/src/assets/
frontend/src/counter.js
frontend/src/ipc-bridge-native.js
frontend/src/vendor/

# Dev utilities
capture_sim_data.py
fft_viewer.py
phaser_sidecar.py
phaser_zmq_server.py
test_minimal.py
start*.bat
start*.py
AGENTS.md

# Generated knowledge graph
graphify-out/

# Local backups
*.bak

# Reference material (kept locally, not in repo — too large for git,
# and it's binary reference material, not source)
docs/*.pdf
!docs/2025_Phaser_labs_Python.pdf

# Superseded design/status notes now live in archive/ and are tracked.

# One-off Windows spike; kept locally, not part of the repo.
tools/phase0_spike.py

# Short-lived GitHub token handed to the container; deleted after use.
.gh-token

# The GitHub Pages build (deploy-pages.yml). Kept out of the repo on purpose:
# frontend/dist/ is committed because install.sh ships it to the Pi and must
# keep defaulting to the real backend, while this one is built with
# VITE_TRANSPORT=sim. Committing both invites shipping the sim default to
# hardware.
frontend/dist-pages/

# Scratch file written by the Pages smoke test in CI.
frontend/pages-smoke.mjs
